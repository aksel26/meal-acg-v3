{
  "name": "with-tailwind",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test:db": "bash scripts/test-supabase-sql.sh",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "build:user": "turbo run build --filter=user",
    "dev:user": "turbo run dev --filter=user",
    "start:user": "turbo run start --filter=user",
    "build:admin": "turbo run build --filter=admin",
    "dev:admin": "turbo run dev --filter=admin",
    "start:admin": "turbo run start --filter=admin",
    "build:part-time-supervisor": "turbo run build --filter=part-time-supervisor",
    "dev:part-time-supervisor": "turbo run dev --filter=part-time-supervisor",
    "start:part-time-supervisor": "turbo run start --filter=part-time-supervisor",
    "build:project-management": "turbo run build --filter=project-management",
    "dev:project-management": "turbo run dev --filter=project-management",
    "start:project-management": "turbo run start --filter=project-management"
  },
  "devDependencies": {
    "prettier": "^3.6.0",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "turbo": "^2.5.5"
  },
  "packageManager": "pnpm@8.15.6",
  "engines": {
    "node": ">=18"
  }
}
